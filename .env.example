# Copy to .env and adjust. All values have development defaults in docker-compose.yml.
DB_USERNAME=mathtutor
DB_PASSWORD=mathtutor
# Required: a long random secret that signs logins, e.g. `openssl rand -base64 48`. Never reuse the example values.
JWT_SECRET=
MATH_SERVICE_API_KEY=dev-math-key
ADMIN_EMAIL=admin@mathtutor.local
ADMIN_PASSWORD=Admin@123
SEED_DEMO_DATA=true
# Host ports (change BACKEND_PORT if 8080 is taken)
FRONTEND_PORT=3000
BACKEND_PORT=8080
MATH_SERVICE_PORT=8000
POSTGRES_PORT=5432
PGADMIN_PORT=5050
