{
  "name": "mathtutor-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "MathTutor web client: React Native (react-native-web) + TypeScript, bundled with webpack, run with Bun",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "katex": "0.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-web": "0.21.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-native-web": "0.19.3",
    "babel-loader": "9.2.1",
    "babel-plugin-react-native-web": "0.21.3",
    "css-loader": "7.1.5",
    "html-webpack-plugin": "5.6.8",
    "style-loader": "4.0.0",
    "typescript": "5.9.3",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  }
}
