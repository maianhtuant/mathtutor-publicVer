# Copy to .env.production on the server (never commit the real file) and fill in every value.
# Used by compose.production.yml; all of them are required.
DB_USERNAME=
DB_PASSWORD=
# A long random secret, e.g. `openssl rand -base64 48`.
JWT_SECRET=
MATH_SERVICE_API_KEY=
# First admin account, created only when the database has none.
ADMIN_EMAIL=
ADMIN_PASSWORD=
