    {
      "id": "AP01",
      "label": "Circle: area and circumference",
      "category": "Area-and-Perimeter",
      "active": true,
      "template": "{q}",
      "answer_formula": "q.answer_formula",
      "answer_mode": "numeric",
      "variables": {
        "r": {
          "type": "integer",
          "min": 1,
          "max": 15
        },
        "q": {
          "type": "text_choice",
          "options": [
            {
              "text": "A circle has radius \\(r = {r}\\) cm. Find its area in square centimeters. Use \\(\\pi = 3.14\\). Hint: \\(A = \\pi r^{2}\\).",
              "answer_formula": "3.14*r^2",
              "figure": {
                "shape": "circle",
                "labels": {
                  "radius": "r = {r} cm"
                }
              }
            },
            {
              "text": "A circle has diameter \\(d = {d}\\) cm. Find its area in square centimeters. Use \\(\\pi = 3.14\\). Hint: the radius is half the diameter, \\(r = d \\div 2\\), then \\(A = \\pi r^{2}\\).",
              "answer_formula": "3.14*(d/2)^2",
              "figure": {
                "shape": "circle",
                "labels": {
                  "diameter": "d = {d} cm"
                }
              }
            },
            {
              "text": "A circle has radius \\(r = {r}\\) cm. Find its circumference (perimeter) in centimeters. Use \\(\\pi = 3.14\\). Hint: \\(C = 2\\pi r\\).",
              "answer_formula": "2*3.14*r",
              "figure": {
                "shape": "circle",
                "labels": {
                  "radius": "r = {r} cm"
                }
              }
            },
            {
              "text": "A circle has diameter \\(d = {d}\\) cm. Find its circumference (perimeter) in centimeters. Use \\(\\pi = 3.14\\). Hint: \\(C = \\pi d\\).",
              "answer_formula": "3.14*d",
              "figure": {
                "shape": "circle",
                "labels": {
                  "diameter": "d = {d} cm"
                }
              }
            }
          ]
        }
      },
      "derived_variables": {
        "d": "2*r"
      },
      "constraints": [],
      "grading_tolerance_percent": 0,
      "absolute_tolerance": 0,
      "decimal_places": 2,
      "accept_rounded_decimal": false,
      "explanation": "Area A = πr²; circumference C = 2πr = πd; r = d ÷ 2."
    },
